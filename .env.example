# ODIVORA Home Connectivity — local dev defaults.
# NEVER commit real production secrets. Copy to .env for local use.
APP_NAME=odivora-home-connectivity
APP_ENV=dev
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
GATEWAY_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./odivora_home.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://odivora:odivora@postgres:5432/odivora_home
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
PAIRING_CODE_TTL_MINUTES=15
HEARTBEAT_OFFLINE_AFTER_SECONDS=120
CORS_ORIGINS=*
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PAIRING_MAX_ATTEMPTS=5
AUTH_RATE_PER_MINUTE=10
GATEWAY_RATE_PER_MINUTE=30
SESSION_MAX_ACTIVE=5
TUNNEL_PROVIDER=null
# --- Audit trail / device forensics ---
# Real client IP behind a reverse proxy: use the LAST X-Forwarded-For hop
# (appended by the proxy). Set false when the API is directly exposed.
TRUST_PROXY_HEADERS=true
# How many visited sites are kept per device + tunnel session ("first ten").
VISIT_SITE_LIMIT=10
# Max rows returned by a single audit query / report section.
AUDIT_PAGE_MAX=500
# --- Gateway event cache (store-and-forward backfill) ---
# How long gateway-reported events are kept. They are evidence, not the ledger
# (that is audit_logs / device_visits), so they age out; 0 disables the prune.
GATEWAY_EVENT_RETENTION_DAYS=90
# Caps one batch POST may carry — an agent bug must not grow the table without
# bound, so the endpoint rejects anything larger (422) instead.
EVENT_BATCH_MAX_EVENTS=200
EVENT_BATCH_MAX_BYTES=262144
# --- V1B relay / NAT traversal ---
# Dev: leave RELAY_CONTROL_URL empty so the API allocates port pairs without
# a control call; set RELAY_PUBLIC_HOST to the relay's reachable IP/DNS when
# testing real relay traffic, and set RELAY_CONTROL_URL to http://<relay>:9090.
RELAY_CONTROL_URL=
RELAY_PUBLIC_HOST=127.0.0.1
RELAY_PORT_START=20000
RELAY_PORT_END=20999
# Billing / M-Pesa Daraja (stubs; live only when BILLING_LIVE=true)
BILLING_LIVE=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CURRENCY=KES
MPESA_ACCOUNT_REF=ODIVORA
MPESA_TRANSACTION_DESC=ODIVORA plan
# Vendor script aliases (optional — derived automatically if empty):
# MPESA_ENVIRONMENT=sandbox (or set MPESA_ENV above; bridge maps it)
# MPESA_ACCOUNT_REFERENCE= (defaults to MPESA_ACCOUNT_REF)
# MPESA_AUTH_URL= MPESA_STK_PUSH_URL= MPESA_QUERY_URL= (derived from MPESA_ENV if empty)
# MPESA_CALLBACK_ALLOWED_IPS= (comma list; sandbox defaults built in; empty in prod = skip)
# MPESA_MAX_AMOUNT=100000

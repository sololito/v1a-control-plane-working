# ODIVORA V1B - VPS co-located backend + relay.
# Copy to /opt/odivora-v1b/.env and fill SECRET_KEY. Never commit this file.
APP_ENV=prod
SECRET_KEY=replace-with-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:////opt/odivora-v1b/odivora_home.db
CORS_ORIGINS=*
TRUST_PROXY_HEADERS=true
MAINTENANCE_ENABLED=true
TUNNEL_PROVIDER=null

# --- V1B relay (co-located on this host) ---
# The API is the relay's only control client, so it talks over loopback.
RELAY_CONTROL_URL=http://127.0.0.1:9090
# What phone/gateway configs advertise as the relay endpoint. Use the stable
# DNS name (resolves to this VPS) so configs survive an IP change.
RELAY_PUBLIC_HOST=relay.odivora.com
RELAY_PORT_START=20000
RELAY_PORT_END=20999

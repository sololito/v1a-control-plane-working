[Unit]
Description=ODIVORA Linux Home Gateway (V1B)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/odivora
ExecStart=/opt/odivora/venv/bin/python /opt/odivora/firmware/linux_gateway/gateway_agent.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
